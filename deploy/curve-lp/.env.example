# Environment variables for Curve LP Solver deployment
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values
# 3. NEVER commit .env to git
#
# QUOTING:
# deploy.sh sources this file with `set -a; source .env; set +a`. That means
# shell-special characters in values are interpreted unless quoted. Wrap any
# value containing `?`, `&`, `=`, `#`, `$`, `*`, `;`, `|`, `(`, `)`, `<`, `>`,
# or spaces in DOUBLE quotes — typical for RPC URLs with query-string keys
# (`?key=...&foo=bar`). When in doubt, quote.
#
#   NODE_URL="https://rpc.example.com/v1?api_key=abc&chain=eth"   # safe
#   NODE_URL=https://rpc.example.com/v1?api_key=abc&chain=eth     # broken:
#       # `&chain=eth` runs as a background command, NODE_URL silently ends
#       # at the `?`, and the deploy fails with "missing NODE_URL".
#
# For production on AWS, use:
# - AWS Secrets Manager, or
# - SSM Parameter Store, or
# - ECS task definition secrets

# Ethereum mainnet RPC endpoint (used by both prod and staging mainnet containers).
NODE_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE"

# Deployed CurveRouterV2 address used by https://ethereum.router.curve.finance/quote.
ROUTER_ADDRESS_MAINNET="0xa1c7a8360eb4049595a24d6919e74e105b409cb5"

# Arbitrum One RPC endpoint.
NODE_URL_ARBITRUM="https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE"

# Deployed CurveRouterV2 address used by https://arbitrum.router.curve.finance/quote.
ROUTER_ADDRESS_ARBITRUM="0xa1c7a8360eb4049595a24d6919e74e105b409cb5"

# Gnosis Chain RPC endpoint.
NODE_URL_GNOSIS="https://gnosis-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE"

# Deployed CurveRouterV2 address used by https://gnosis.router.curve.finance/quote.
ROUTER_ADDRESS_GNOSIS="0xa1c7a8360eb4049595a24d6919e74e105b409cb5"

# Base RPC endpoint.
NODE_URL_BASE="https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE"

# Deployed CurveRouterV2 address used by https://base.router.curve.finance/quote.
ROUTER_ADDRESS_BASE="0xa1c7a8360eb4049595a24d6919e74e105b409cb5"

# Domain for SSL certificate
DOMAIN=solver.momotaro.xyz

# Email for Let's Encrypt notifications
SSL_EMAIL=admin@momotaro.xyz

# Monitor UI at /monitor/ (optional). Set BOTH to enable the Basic-auth
# protected monitor page; omit both to disable. Password can contain shell
# metacharacters — quote it.
MONITOR_USER="ops"
MONITOR_PASSWORD="change-me"

# Telegram monitoring (optional)
#
# Two notification streams per chain, each routed to its own topic:
#   TG_TRADES_THREAD_* -> "Solution Candidate": we produced a candidate
#                         solution (got SELECTED to bid). NOT settled.
#   TG_WINS_THREAD_*   -> "Auction Won": confirmed SETTLED on-chain tx
#                         (has tx hash + block). The real executed trade.
# An unset *_THREAD_<CHAIN> falls back to TG_TRADES_THREAD / TG_WINS_THREAD.
TG_BOT_TOKEN=your-bot-token-from-botfather
TG_CHAT_ID=-1003703653353
TG_STATS_THREAD=                 # General topic (leave empty for default)
TG_TRADES_THREAD=3               # Legacy/default candidate topic fallback
TG_TRADES_THREAD_MAINNET=3       # Mainnet candidates ("Solution Candidate")
TG_TRADES_THREAD_ARBITRUM=4      # Arbitrum candidates ("Solution Candidate")
TG_TRADES_THREAD_GNOSIS=5        # Gnosis candidates ("Solution Candidate")
TG_TRADES_THREAD_BASE=           # Base candidates ("Solution Candidate")
TG_WINS_THREAD=                  # Legacy/default settled-tx topic fallback
TG_WINS_THREAD_MAINNET=          # Mainnet settled tx ("Auction Won")
TG_WINS_THREAD_ARBITRUM=         # Arbitrum settled tx ("Auction Won")
TG_WINS_THREAD_GNOSIS=           # Gnosis settled tx ("Auction Won")
TG_WINS_THREAD_BASE=             # Base settled tx ("Auction Won")
